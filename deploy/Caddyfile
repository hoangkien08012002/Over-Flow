# Edge for the production-like stack: TLS termination, the static web client, and a reverse proxy to the API.
# SITE_ADDRESS=localhost uses Caddy's internal CA (self-signed, for rehearsals). A public DNS name gets a Let's Encrypt
# certificate automatically, which needs ports 80 and 443 reachable from the internet.
{
	admin off
}

{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	# Caddy sets X-Forwarded-For and X-Forwarded-Proto. The API trusts them only from this container's fixed address.
	handle /api/* {
		reverse_proxy api:8080
	}
	# Liveness only. Readiness lists dependency states, which is operator information, so it stays on the internal network.
	handle /health/live {
		reverse_proxy api:8080
	}
	handle /health/* {
		respond 404
	}

	handle {
		root * /srv
		# Hashed bundles never change, so they are cached for a year. index.html is revalidated so a deploy is picked up at once.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@shell not path /assets/*
		header @shell Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
		# MUI injects style elements at runtime, so styles need 'unsafe-inline'. Scripts stay limited to this origin.
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
			X-Content-Type-Options nosniff
			X-Frame-Options DENY
			Referrer-Policy no-referrer
		}
	}

	header Strict-Transport-Security "max-age=31536000"
	header -Server

	log {
		output stdout
		format json
	}
}
