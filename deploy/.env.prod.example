# Copy to deploy/.env.prod (ignored by Git) and replace every placeholder. deploy.ps1 refuses to run while one remains.
# Generate secrets, for example in PowerShell:
#   [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))

# SQL Server SA password. Avoid ';' and quotes: the value is placed inside the connection string.
MSSQL_SA_PASSWORD=REPLACE_WITH_STRONG_SQL_PASSWORD
SQL_DATABASE=OrderFlow
# Developer is for rehearsals only. Use Express or a licensed edition for a real deployment.
MSSQL_PID=Developer

# At least 32 bytes. Rotating it signs every user out once.
JWT_SIGNING_KEY=REPLACE_WITH_RANDOM_KEY_AT_LEAST_32_BYTES
JWT_ISSUER=OrderFlow
JWT_AUDIENCE=OrderFlow.Api

# localhost uses Caddy's internal, self-signed CA. A public DNS name gets a Let's Encrypt certificate (needs HTTP_BIND=0.0.0.0).
SITE_ADDRESS=localhost
HTTP_BIND=127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443

# The edge container's fixed address, trusted for X-Forwarded-For. Must be inside BACKEND_SUBNET.
BACKEND_SUBNET=172.30.0.0/24
EDGE_IP=172.30.0.10

# Every page load refreshes the session once (D-34), so visitors behind one address share this per-minute budget.
RATE_LIMIT_REFRESH=20

# Image naming. deploy.ps1 sets IMAGE_TAG from the Git commit unless -Tag is given.
IMAGE_REGISTRY=orderflow
OTLP_ENDPOINT=
