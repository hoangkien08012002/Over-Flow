{
  "Jwt": {
    "Issuer": "OrderFlow.Local",
    "Audience": "OrderFlow.Api",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Redis": {
    "ConnectionString": "127.0.0.1:6379",
    "TimeoutMilliseconds": 250
  },
  "Inventory": {
    "ReservationMinutes": 15
  },
  "Ordering": {
    "IdempotencyRetentionHours": 24
  },
  "Retention": {
    "InboxDays": 30
  },
  "Returns": {
    "WindowDays": 7
  },
  "RateLimits": {
    "Register": 20,
    "Login": 20,
    "Refresh": 20,
    "Logout": 20,
    "Search": 300,
    "Checkout": 60
  },
  "Kafka": {
    "BootstrapServers": "127.0.0.1:9092"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Proxy": {
    "TrustedProxies": []
  },
  "Telemetry": {
    "OtlpEndpoint": ""
  }
}
