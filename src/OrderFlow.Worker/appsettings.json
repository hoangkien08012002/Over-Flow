{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Kafka": {
    "BootstrapServers": "127.0.0.1:9092",
    "ConsumerGroupPrefix": "orderflow-",
    "TopicPartitions": 3,
    "ReplicationFactor": 1,
    "PublishTimeoutMilliseconds": 10000,
    "TopicRetentionDays": 7
  },
  "Retention": {
    "OutboxDays": 7,
    "InboxDays": 30,
    "FailedMessageDays": 90,
    "BatchSize": 1000,
    "SweepSeconds": 3600
  },
  "Outbox": {
    "BatchSize": 50,
    "PollIntervalMilliseconds": 500,
    "LeaseSeconds": 60,
    "BaseRetryMilliseconds": 1000,
    "MaxRetrySeconds": 60
  },
  "Consumers": {
    "MaxAttempts": 5,
    "BaseRetryMilliseconds": 200,
    "MaxRetryMilliseconds": 5000,
    "ReplayPollSeconds": 5
  },
  "Inventory": {
    "ReservationMinutes": 15
  },
  "ReservationExpiry": {
    "SweepSeconds": 30,
    "BatchSize": 100
  },
  "Payments": {
    "DeclineCents": 13
  },
  "Refunds": {
    "MaxAttempts": 3,
    "RetryDelaySeconds": 30,
    "PollSeconds": 5,
    "BatchSize": 50
  },
  "Telemetry": {
    "OtlpEndpoint": ""
  }
}
